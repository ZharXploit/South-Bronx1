        showWarning("Auto Farm", "Proses masak Marshmallow dimulai...")
        if marshmallowFarmThread then task.cancel(marshmallowFarmThread) end
        
        marshmallowFarmThread = task.spawn(function()
            while getgenv().ZharXUI.MarshmallowFarm do
