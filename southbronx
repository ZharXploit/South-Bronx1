    end
    
    showWarning("Auto Buy", "✅ Bahan Marshmallow berhasil dibeli!")
    return true
end

function autoBuyPotato()
    showWarning("Auto Buy", "🔍 Mencari Dealer Kentang...")
    
    if not DealerLocations.PotatoDealer then
        showWarning("Error", "Set lokasi Dealer Kentang dulu!")
        return false
    end
    
    if not safeTeleport(DealerLocations.PotatoDealer, "Dealer Kentang") then
        return false
    end
    
    task.wait(0.5)
    
    local buyPrompt = findNearestPrompt({"buy", "beli", "potato", "kentang", "flour", "tepung"}, 15)
    
    if not buyPrompt then
        showWarning("Error", "❌ Tidak menemukan prompt beli Kentang!")
        return false
    end
    
    showWarning("Auto Buy", "🛒 Membeli bahan Kentang...")
    
    for i = 1, 5 do
        fireproximityprompt(buyPrompt)
        task.wait(0.3)
    end
    
    showWarning("Auto Buy", "✅ Bahan Kentang berhasil dibeli!")
    return true
end

-- ============================================
-- AUTO FARM FULL CYCLE
-- ============================================

function startAutoFarm()
    if isAutoFarming then
        showWarning("Info", "Auto Farm sudah berjalan!")
        return
    end
    
    if not DealerLocations.MarshmallowDealer then
        showWarning("Error", "Set Dealer Marshmallow dulu!")
        return
    end
    if not DealerLocations.PotatoDealer then
        showWarning("Error", "Set Dealer Kentang dulu!")
        return
    end
    if not DealerLocations.Apartemen then
        showWarning("Error", "Set Apartemen/Dapur dulu!")
        return
    end
    if not DealerLocations.SellSpot then
        showWarning("Error", "Set Tempat Jual dulu!")
        return
    end
    
    isAutoFarming = true
    showWarning("Auto Farm", "🚀 AUTO FARM DIMULAI!", 3)
    
    autoFarmThread = task.spawn(function()
        local cycleCount = 0
        
        while isAutoFarming do
            cycleCount = cycleCount + 1
            showWarning("Cycle", "🔄 Siklus #" .. cycleCount .. " dimulai!")
            
            if isAutoFarming then
                autoBuyMarshmallow()
                task.wait(0.5)
                autoBuyPotato()
            end
            
            task.wait(1)
            
            if isAutoFarming then
                if safeTeleport(DealerLocations.Apartemen, "Apartemen") then
                    getgenv().ZharXUI.MarshmallowFarm = true
                    toggleMarshmallowFarm(true)
                    task.wait(5)
                    toggleMarshmallowFarm(false)
                    
                    getgenv().ZharXUI.PotatoFarm = true
                    togglePotatoFarm(true)
                    task.wait(5)
                    togglePotatoFarm(false)
                end
            end
            
            task.wait(1)
            
            if isAutoFarming then
                if safeTeleport(DealerLocations.SellSpot, "Tempat Jual") then
                    getgenv().ZharXUI.AutoSellEnabled = true
                    toggleAutoSell(true)
                    task.wait(5)
                    toggleAutoSell(false)
                end
            end
            
            task.wait(2)
            showWarning("Cycle", "✅ Siklus #" .. cycleCount .. " selesai!")
            task.wait(3)
        end
    end)
end

function stopAutoFarm()
    isAutoFarming = false
    if autoFarmThread then
        task.cancel(autoFarmThread)
        autoFarmThread = nil
    end
    toggleMarshmallowFarm(false)
    togglePotatoFarm(false)
    toggleAutoSell(false)
    showWarning("Auto Farm", "⏹️ AUTO FARM DIHENTIKAN!", 2)
end

