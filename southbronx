-- ============================================

local function safeHttpGet(url, retries)
    retries = retries or 3
    for i = 1, retries do
        local success, result = pcall(function()
            return game:HttpGet(url)
        end)
        if success then return result end
        task.wait(1)
    end
    return nil
end

