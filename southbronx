-- ============================================
-- TAMBAHAN UI UNTUK AUTO BUY (South Bronx)
-- Masukkan ke dalam script UI utama (setelah MainWindow dibuat)
-- ============================================

-- ============================================
-- 1. TAB AUTO BUY
-- ============================================
local AutoBuyTab = MainWindow:NewTab("Auto Buy")

-- ============================================
-- 2. SECTION SET WAYPOINT
-- ============================================
local WaypointSection = AutoBuyTab:NewSection("📍 Set Waypoint (Berdiri di Tempat)")

WaypointSection:NewButton("Set Dealer Marshmallow", "Berdiri di lapangan basket belakang dealer", function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        DealerLocations.MarshmallowDealer = char.HumanoidRootPart.CFrame
        showWarning("Waypoint Set", "✅ Dealer Marshmallow tersimpan!")
    else
        showWarning("Error", "Karakter tidak ditemukan!")
    end
end)

WaypointSection:NewButton("Set Dealer Kentang", "Berdiri di dealer kentang", function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        DealerLocations.PotatoDealer = char.HumanoidRootPart.CFrame
        showWarning("Waypoint Set", "✅ Dealer Kentang tersimpan!")
    else
        showWarning("Error", "Karakter tidak ditemukan!")
    end
end)

WaypointSection:NewButton("Set Apartemen/Dapur", "Berdiri di tempat masak", function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        DealerLocations.Apartemen = char.HumanoidRootPart.CFrame
        showWarning("Waypoint Set", "✅ Apartemen tersimpan!")
    else
        showWarning("Error", "Karakter tidak ditemukan!")
    end
end)

WaypointSection:NewButton("Set Tempat Jual", "Berdiri di tempat jual hasil", function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        DealerLocations.SellSpot = char.HumanoidRootPart.CFrame
        showWarning("Waypoint Set", "✅ Tempat Jual tersimpan!")
    else
        showWarning("Error", "Karakter tidak ditemukan!")
    end
end)

-- ============================================
-- 3. SECTION AUTO BUY
-- ============================================
local BuySection = AutoBuyTab:NewSection("🛒 Auto Beli Bahan")

BuySection:NewButton("Beli Marshmallow", "Beli Gelatin + Water + Sugar Block Bag", function()
    task.spawn(function()
        autoBuyMarshmallow()
    end)
end)

BuySection:NewButton("Beli Kentang", "Beli bahan kentang/tepung", function()
    task.spawn(function()
        autoBuyPotato()
    end)
end)

BuySection:NewButton("Beli Semua", "Beli marshmallow + kentang", function()
    task.spawn(function()
        autoBuyMarshmallow()
        task.wait(1)
        autoBuyPotato()
    end)
end)

-- ============================================
-- 4. SECTION AUTO FARM (FULL CYCLE)
-- ============================================
local FarmSection = AutoBuyTab:NewSection("🚀 Auto Farm Full Cycle")

FarmSection:NewToggle("Auto Farm ON/OFF", "Beli → Masak → Jual → Ulang", function(state)
    if state then
        startAutoFarm()
    else
        stopAutoFarm()
    end
end)

FarmSection:NewButton("⚠️ Stop All", "Hentikan semua proses", function()
    stopAutoFarm()
    showWarning("Stopped", "⏹️ Semua proses dihentikan!")
end)

-- ============================================
-- 5. SECTION STATUS
-- ============================================
local StatusSection = AutoBuyTab:NewSection("📊 Status")

StatusSection:NewButton("Cek Status", "Lihat status waypoint & inventory", function()
    task.spawn(function()
        local status = "=== STATUS AUTO FARM ===\n"
        status = status .. "\n📍 WAYPOINT:\n"
        status = status .. "  Dealer Marshmallow: " .. (DealerLocations.MarshmallowDealer and "✅ SET" or "❌ NOT SET") .. "\n"
        status = status .. "  Dealer Kentang: " .. (DealerLocations.PotatoDealer and "✅ SET" or "❌ NOT SET") .. "\n"
        status = status .. "  Apartemen: " .. (DealerLocations.Apartemen and "✅ SET" or "❌ NOT SET") .. "\n"
        status = status .. "  Tempat Jual: " .. (DealerLocations.SellSpot and "✅ SET" or "❌ NOT SET") .. "\n"
        status = status .. "\n🎒 INVENTORY:\n"
        
        local hasGel = hasItem({"gelatin", "gel"})
        local hasWater = hasItem({"water"})
        local hasSugar = hasItem({"sugar", "block"})
        local hasPotato = hasItem({"potato", "kentang"})
        
        status = status .. "  Gelatin: " .. (hasGel and "✅ ADA" or "❌ KOSONG") .. "\n"
        status = status .. "  Water: " .. (hasWater and "✅ ADA" or "❌ KOSONG") .. "\n"
        status = status .. "  Sugar Block: " .. (hasSugar and "✅ ADA" or "❌ KOSONG") .. "\n"
        status = status .. "  Kentang: " .. (hasPotato and "✅ ADA" or "❌ KOSONG") .. "\n"
        
        showWarning("Status", status)
    end)
end)

-- ============================================
-- 6. UPDATE GLOBAL DEALER LOCATIONS
-- ============================================
-- Pastikan DealerLocations tersedia di global
if not getgenv().DealerLocations then
    getgenv().DealerLocations = {
        MarshmallowDealer = nil,
        PotatoDealer = nil,
        Apartemen = nil,
        SellSpot = nil
    }
end

-- Sync dengan global
DealerLocations = getgenv().DealerLocations

print("✅ UI Auto Buy berhasil ditambahkan!")
