-- KILL AURA ULTIMATE v3.0 - SOUTH BRONX
-- Auto pegang senjata + Auto tembak + Tembus tembok
-- ============================================

-- Variabel Kill Aura
local killAuraConnection = nil
local killAuraShootConnection = nil
local isKillAuraActive = false
local currentTarget = nil
local killAuraWeapon = nil

-- ============================================
-- FUNGSI: Ambil senjata terbaik
-- ============================================

local function getBestWeapon()
    local char = LocalPlayer.Character
    if not char then return nil end
    
    -- Cek senjata yang dipegang sekarang
    local currentWeapon = char:FindFirstChildOfClass("Tool")
    if currentWeapon then
        return currentWeapon
    end
    
    -- Cari senjata di backpack
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        local weapons = {}
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                table.insert(weapons, tool)
            end
        end
        
        -- Ambil senjata pertama yang ditemukan
        if #weapons > 0 then
            return weapons[1]
        end
    end
    
    return nil
end

-- ============================================
-- FUNGSI: Auto pegang senjata
-- ============================================

local function autoEquipWeapon()
    local char = LocalPlayer.Character
    if not char then return false end
    
    -- Cek apakah sudah pegang senjata
    local currentWeapon = char:FindFirstChildOfClass("Tool")
    if currentWeapon then
        killAuraWeapon = currentWeapon
        return true
    end
    
    -- Cari senjata di backpack
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return false end
    
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            -- Pindahkan ke karakter
            local success = pcall(function()
                tool.Parent = char
            end)
            if success then
                killAuraWeapon = tool
                return true
            end
        end
    end
    
    return false
end

-- ============================================
-- FUNGSI: Auto tembak (simulasi click)
-- ============================================

local function autoShoot(target)
    if not target or not target.Character then return end
    
    local targetChar = target.Character
    local targetHead = targetChar:FindFirstChild("Head")
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    local targetHumanoid = targetChar:FindFirstChild("Humanoid")
    
    if not targetHumanoid or targetHumanoid.Health <= 0 then return end
    
    -- Method 1: Arahkan kamera ke target (untuk aim assist)
    local aimPart = targetHead or targetRoot
    if aimPart then
        pcall(function()
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, aimPart.Position)
        end)
    end
    
    -- Method 2: Simulasi mouse click (jika ada mouse)
    pcall(function()
        if getgenv().mouse then
            getgenv().mouse.Button1Down:Fire()
            task.wait(0.02)
            getgenv().mouse.Button1Up:Fire()
        end
    end)
    
    -- Method 3: Coba FireServer langsung ke remote events
    local weapon = killAuraWeapon or getCurrentWeapon()
    if weapon then
        for _, remote in ipairs(weapon:GetDescendants()) do
            if remote:IsA("RemoteEvent") then
                local name = remote.Name:lower()
                if string.find(name, "fire") or string.find(name, "shoot") or 
                   string.find(name, "attack") or string.find(name, "hit") or 
                   string.find(name, "damage") or string.find(name, "click") then
                    pcall(function()
                        remote:FireServer(targetChar, 999)
                        remote:FireServer(targetHumanoid, 999)
                        remote:FireServer(targetHead, 999)
                        remote:FireServer(targetRoot, 999)
                        remote:FireServer(target, 999)
                    end)
                end
            end
        end
    end
    
    -- Method 4: Coba remote events di game
    for _, remote in ipairs(game:GetDescendants()) do
        if remote:IsA("RemoteEvent") then
            local name = remote.Name:lower()
            if string.find(name, "damage") or string.find(name, "hit") or 
               string.find(name, "attack") or string.find(name, "shoot") then
                pcall(function()
                    remote:FireServer(targetChar, 999)
                    remote:FireServer(targetHumanoid, 999)
                    remote:FireServer(targetHead, 999)
                end)
            end
        end
    end
    
    -- Method 5: Coba gunakan tool Activate
    if weapon and weapon:FindFirstChild("Activate") then
        pcall(function()
            weapon.Activate:FireServer()
        end)
    end
    
    -- Method 6: Coba gunakan RemoteFunction
    for _, remote in ipairs(game:GetDescendants()) do
        if remote:IsA("RemoteFunction") then
            local name = remote.Name:lower()
            if string.find(name, "damage") or string.find(name, "hit") or 
               string.find(name, "attack") or string.find(name, "shoot") then
                pcall(function()
                    remote:InvokeServer(targetChar, 999)
                end)
            end
        end
    end
end

-- ============================================
-- FUNGSI: Cari target terbaik (tembus tembok)
-- ============================================

local function findBestTarget(maxRange)
    maxRange = maxRange or 100
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    
    local rootPos = char.HumanoidRootPart.Position
    local bestTarget = nil
    local bestScore = -1
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local targetChar = player.Character
            local targetHumanoid = targetChar:FindFirstChild("Humanoid")
            local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
            
            if targetHumanoid and targetHumanoid.Health > 0 and targetRoot then
                local dist = (rootPos - targetRoot.Position).Magnitude
                
                -- Hitung score (jarak + health)
                local score = (maxRange - dist) + (targetHumanoid.Health / 10)
                
                -- Bonus: target yang lagi visible (tapi kita tetep bisa tembus tembok)
                local raycast = RaycastParams.new()
                raycast.FilterDescendantsInstances = {char}
                raycast.IgnoreWater = true
                
                local ray = workspace:Raycast(rootPos, (targetRoot.Position - rootPos).Unit * dist, raycast)
                if not ray then
                    score = score + 50 -- Bonus untuk target yang ga kehalang tembok
                end
                
                if score > bestScore then
                    bestScore = score
                    bestTarget = player
                end
            end
        end
    end
    
    return bestTarget
end

-- ============================================
-- FUNGSI: Kill Aura Main Loop
-- ============================================

local function killAuraLoop()
    while isKillAuraActive do
        -- Step 1: Auto pegang senjata
        if not killAuraWeapon or not killAuraWeapon.Parent then
            autoEquipWeapon()
        end
        
        -- Step 2: Cari target terbaik
        local maxRange = getgenv().ZharXUI.KillAuraRange or 100
        local target = findBestTarget(maxRange)
        
        if target then
            currentTarget = target
            -- Step 3: Tembak terus ke target
            autoShoot(target)
        end
        
        -- Delay sesuai setting
        local delay = getgenv().ZharXUI.KillAuraDelay or 0.1
        task.wait(delay)
    end
end

-- ============================================
-- FUNGSI: Toggle Kill Aura (GANTI YANG INI)
-- ============================================

function toggleKillAura(state)
    getgenv().ZharXUI.KillAuraEnabled = state
    isKillAuraActive = state
    
    if state then
        -- Hentikan thread lama
        if killAuraThread then
            task.cancel(killAuraThread)
            killAuraThread = nil
        end
        
        -- Auto equip weapon
        autoEquipWeapon()
        
        if not killAuraWeapon then
            showWarning("Kill Aura", "⚠️ Tidak ada senjata! Cari senjata dulu.")
            getgenv().ZharXUI.KillAuraEnabled = false
            isKillAuraActive = false
            return
        end
        
        showWarning("Kill Aura", "🔫 Kill Aura AKTIF! Senjata: " .. killAuraWeapon.Name)
        
        -- Jalankan loop di thread terpisah
        killAuraThread = task.spawn(killAuraLoop)
    else
        -- Matikan
        if killAuraThread then
            task.cancel(killAuraThread)
            killAuraThread = nil
        end
        isKillAuraActive = false
        currentTarget = nil
        killAuraWeapon = nil
        showWarning("Kill Aura", "⏹️ Kill Aura DINONAKTIFKAN")
    end
end

