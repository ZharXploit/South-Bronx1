local function safeTeleport(cframe, locationName)
    if not cframe then
        showWarning("Teleport Gagal", "Lokasi " .. (locationName or "tidak dikenal") .. " belum diset!")
        return false
    end
    
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        showWarning("Teleport Gagal", "Karakter tidak ditemukan!")
        return false
    end
    
    local root = char.HumanoidRootPart
    local success, err = pcall(function()
        root.CFrame = cframe + Vector3.new(0, 3, 0)
    end)
    
    if success then
        showWarning("Teleport Berhasil", "Ke " .. (locationName or "lokasi"))
        return true
    else
        showWarning("Teleport Gagal", err or "Unknown error")
        return false
    end
end

-- ============================================
-- FUNGSI HAS ITEM
-- ============================================

local function hasItem(keywords)
    local player = LocalPlayer
    if not player then return false end
    
    local containers = {
        player:FindFirstChild("Backpack"),
        player:FindFirstChild("StarterPack"),
        player.Character,
        player:FindFirstChild("PlayerGui"),
        player:FindFirstChild("Inventory"),
        player:FindFirstChild("Storage")
    }
    
    for _, container in ipairs(containers) do
        if container then
            for _, item in ipairs(container:GetDescendants()) do
                local nameLower = item.Name:lower()
                for _, keyword in ipairs(keywords) do
                    if string.find(nameLower, keyword:lower()) then
                        return true, item
                    end
                end
            end
        end
    end
    return false, nil
end

-- ============================================
-- FUNGSI FIND NEAREST PROMPT
-- ============================================

local promptCache = {}
local lastCacheTime = 0

local function findNearestPrompt(keywords, maxDistance)
    maxDistance = maxDistance or 30
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    
    local rootPos = char.HumanoidRootPart.Position
    local closest = nil
    local closestDist = maxDistance
    
    local currentTime = tick()
    if currentTime - lastCacheTime > 3 then
        promptCache = {}
        local searchPlaces = {workspace, game:GetService("ReplicatedStorage")}
        for _, place in ipairs(searchPlaces) do
            for _, prompt in ipairs(place:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") then
                    local txt = (prompt.ObjectText or "") .. (prompt.ActionText or "") .. (prompt.Parent and prompt.Parent.Name or "")
                    promptCache[prompt] = txt:lower()
                end
            end
        end
        lastCacheTime = currentTime
    end
    
    for prompt, txt in pairs(promptCache) do
        for _, keyword in ipairs(keywords) do
            if string.find(txt, keyword:lower()) then
                local promptPos = prompt.Parent and prompt.Parent:FindFirstChild("Position")
                if promptPos then
                    local dist = (rootPos - promptPos.Position).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closest = prompt
                    end
                end
            end
        end
    end
    
    return closest
end

-- ============================================
-- BIG HEAD - ANTI LAG
-- ============================================

local bigHeadCache = {}
local bigHeadCacheTime = 0
local bigHeadUpdateInterval = 1.0
local bigHeadFrameCounter = 0
local bigHeadMaxFrames = 3

function removeBigHeadFromEnemies()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            if head then
                local origSize = head:GetAttribute("OriginalHeadSize")
                local origTrans = head:GetAttribute("OriginalTransparency")
                local origCollide = head:GetAttribute("OriginalCanCollide")
                local origMassless = head:GetAttribute("OriginalMassless")
                
                if origSize then head.Size = origSize end
                if origTrans then head.Transparency = origTrans end
                if origCollide ~= nil then head.CanCollide = origCollide end
                if origMassless ~= nil then head.Massless = origMassless end
            end
        end
    end
    bigHeadCache = {}
end

function toggleBigHeadCombat(state)
    getgenv().ZharXUI.BigHeadCombatEnabled = state
    if state then
        if not bigHeadRenderConnection then
            bigHeadRenderConnection = RunService.Heartbeat:Connect(function()
                if not getgenv().ZharXUI.BigHeadCombatEnabled then return end
                
                bigHeadFrameCounter = bigHeadFrameCounter + 1
                if bigHeadFrameCounter < bigHeadMaxFrames then return end
                bigHeadFrameCounter = 0
                
                local now = tick()
                if now - bigHeadCacheTime > bigHeadUpdateInterval then
                    bigHeadCache = {}
                    for _, player in ipairs(Players:GetPlayers()) do
                        if player ~= LocalPlayer and player.Character then
                            local head = player.Character:FindFirstChild("Head")
                            if head and head.Parent then
                                bigHeadCache[player] = head
                            end
                        end
                    end
                    bigHeadCacheTime = now
                end
                
                local currentSize = getgenv().ZharXUI.BigHeadSize or 20
                local currentTrans = (getgenv().ZharXUI.BigHeadTransparency or 30) / 100
                
                for player, head in pairs(bigHeadCache) do
                    if head and head.Parent then
                        if not head:GetAttribute("OriginalHeadSize") then
                            head:SetAttribute("OriginalHeadSize", head.Size)
                        end
                        if not head:GetAttribute("OriginalTransparency") then
                            head:SetAttribute("OriginalTransparency", head.Transparency)
                        end
                        if head:GetAttribute("OriginalCanCollide") == nil then
                            head:SetAttribute("OriginalCanCollide", head.CanCollide)
                        end
                        if head:GetAttribute("OriginalMassless") == nil then
                            head:SetAttribute("OriginalMassless", head.Massless)
                        end
                        
                        head.Size = Vector3.new(currentSize, currentSize, currentSize)
                        head.Transparency = currentTrans
                        head.CanCollide = false
                        head.CanQuery = true
                        head.CanTouch = true
                        head.Massless = true
                    end
                end
            end)
        end
    else
        if bigHeadRenderConnection then
            bigHeadRenderConnection:Disconnect()
            bigHeadRenderConnection = nil
        end
        removeBigHeadFromEnemies()
        bigHeadCache = {}
        bigHeadFrameCounter = 0
    end
end

-- ============================================
-- FLY
-- ============================================

function toggleFly(state)
    if state then
        local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local RootPart = Character:FindFirstChild("HumanoidRootPart")
        if not RootPart then return end
        if bodyVelocity then bodyVelocity:Destroy() end
        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(40000, 40000, 40000)
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        bodyVelocity.Parent = RootPart
        if flyConnection then flyConnection:Disconnect() end
        flyConnection = RunService.Heartbeat:Connect(function()
            if not bodyVelocity or not bodyVelocity.Parent then return end
            local CamCFrame = Camera.CFrame
            local Velocity = Vector3.new(0, 0, 0)
            local speed = getgenv().ZharXUI.FlySpeed or 50
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then Velocity = Velocity + CamCFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then Velocity = Velocity - CamCFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then Velocity = Velocity - CamCFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then Velocity = Velocity + CamCFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then Velocity = Velocity + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then Velocity = Velocity - Vector3.new(0, 1, 0) end
            if Velocity.Magnitude > 0 then
                bodyVelocity.Velocity = Velocity.Unit * speed
            else
                bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            end
        end)
    else
        if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
        if bodyVelocity then bodyVelocity:Destroy(); bodyVelocity = nil end
    end
end

