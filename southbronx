local function getCurrentWeapon()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Tool")
end

local function autoEquipWeapon()
    local char = LocalPlayer.Character
    if not char then return false end
    
    local currentWeapon = char:FindFirstChildOfClass("Tool")
    if currentWeapon then
        killAuraWeapon = currentWeapon
        return true
    end
    
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return false end
    
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            pcall(function()
                tool.Parent = char
            end)
            killAuraWeapon = tool
            return true
        end
    end
    return false
end

-- SERANG SEMUA TARGET SEKALIGUS!
local function dealDamageToAllTargets()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local rootPos = char.HumanoidRootPart.Position
    local maxRange = getgenv().ZharXUI.KillAuraRange or 150
    local damage = getgenv().ZharXUI.KillAuraDamage or 999
    
    local targets = {}
    
    -- Kumpulkan semua target dalam jangkauan
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local targetChar = player.Character
            local targetHumanoid = targetChar:FindFirstChild("Humanoid")
            local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
            
            if targetHumanoid and targetHumanoid.Health > 0 and targetRoot then
                local dist = (rootPos - targetRoot.Position).Magnitude
                if dist < maxRange then
                    table.insert(targets, player)
                end
            end
        end
    end
    
    if #targets == 0 then return end
    
    -- SERANG SEMUA TARGET SEKALIGUS!
    for _, target in ipairs(targets) do
        local targetChar = target.Character
        local targetHumanoid = targetChar:FindFirstChild("Humanoid")
        local targetHead = targetChar:FindFirstChild("Head")
        local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
        
        if targetHumanoid and targetHumanoid.Health > 0 then
            -- Method 1: FireServer via weapon
            local weapon = killAuraWeapon or getCurrentWeapon()
            if weapon then
                for _, remote in ipairs(weapon:GetDescendants()) do
                    if remote:IsA("RemoteEvent") then
                        pcall(function()
                            remote:FireServer(targetChar, damage)
                            remote:FireServer(targetHumanoid, damage)
                            remote:FireServer(targetHead, damage)
                            remote:FireServer(targetRoot, damage)
                        end)
                    end
                end
            end
            
            -- Method 2: FireServer via game
            for _, remote in ipairs(game:GetDescendants()) do
                if remote:IsA("RemoteEvent") then
                    local name = remote.Name:lower()
                    if string.find(name, "damage") or string.find(name, "hit") or 
                       string.find(name, "attack") or string.find(name, "shoot") or
                       string.find(name, "fire") then
                        pcall(function()
                            remote:FireServer(targetChar, damage)
                            remote:FireServer(targetHumanoid, damage)
                            remote:FireServer(targetHead, damage)
                            remote:FireServer(targetRoot, damage)
                        end)
                    end
                end
            end
            
            -- Method 3: RemoteFunction
            for _, remote in ipairs(game:GetDescendants()) do
                if remote:IsA("RemoteFunction") then
                    local name = remote.Name:lower()
                    if string.find(name, "damage") or string.find(name, "hit") or 
                       string.find(name, "attack") or string.find(name, "shoot") then
                        pcall(function()
                            remote:InvokeServer(targetChar, damage)
                            remote:InvokeServer(targetHumanoid, damage)
                        end)
                    end
                end
            end
            
            -- Method 4: Tool Activate
            if weapon and weapon:FindFirstChild("Activate") then
                pcall(function()
                    weapon.Activate:FireServer()
                end)
            end
        end
    end
    
    -- Kalau ada target, arahkan kamera ke target pertama (opsional)
    if #targets > 0 then
        local firstTarget = targets[1]
        if firstTarget and firstTarget.Character then
            local aimPart = firstTarget.Character:FindFirstChild("Head") or firstTarget.Character:FindFirstChild("HumanoidRootPart")
            if aimPart then
                pcall(function()
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, aimPart.Position)
                end)
            end
        end
    end
    
    -- Tampilkan jumlah target yang diserang (cuma kadang-kadang biar ga spam)
    if #targets > 0 and math.random(1, 10) == 1 then
        showWarning("Kill Aura", "⚔️ Menyerang " .. #targets .. " target!")
    end
end

function toggleKillAura(state)
    getgenv().ZharXUI.KillAuraEnabled = state
    isKillAuraActive = state
    
    if state then
        if killAuraThread then
            task.cancel(killAuraThread)
            killAuraThread = nil
        end
        
        -- Auto equip weapon
        autoEquipWeapon()
        
        if not killAuraWeapon then
            showWarning("Kill Aura", "⚠️ Tidak ada senjata! Cari senjata dulu.")
            getgenv().ZharXUI.KillAuraEnabled = false
            isKillAuraActive = false
            return
        end
        
        showWarning("Kill Aura", "🔫 Kill Aura MULTI-TARGET AKTIF! Semua musuh dalam jangkauan akan mati!")
        
        killAuraThread = task.spawn(function()
            while isKillAuraActive do
                -- Cek weapon masih ada
                if not killAuraWeapon or not killAuraWeapon.Parent then
                    autoEquipWeapon()
                    if not killAuraWeapon then
                        showWarning("Kill Aura", "⚠️ Senjata hilang! Matikan dan nyalakan ulang.")
                        break
                    end
                end
                
                -- SERANG SEMUA TARGET!
                dealDamageToAllTargets()
                
                -- Delay
                local delay = getgenv().ZharXUI.KillAuraDelay or 0.05
                task.wait(delay)
            end
        end)
    else
        if killAuraThread then
            task.cancel(killAuraThread)
            killAuraThread = nil
        end
        isKillAuraActive = false
        killAuraWeapon = nil
        showWarning("Kill Aura", "⏹️ Kill Aura DINONAKTIFKAN")
    end
end

